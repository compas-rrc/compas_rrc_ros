<launch>
    <!-- robot_ip: IP-address of the robot's socket-messaging server -->
    <arg name="robot_ip" description="IP of the controller" />
    <arg name="robot_streaming_port" default="30101" description="Port of the streaming interface" />
    <arg name="robot_state_port" default="30201" description="Port of the state interface" />
    <arg name="sequence_check_mode" default="none" description="Define sequence ID check mode. Supported: none|all|incoming|outgoing" />

    <!--
    <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" />
    -->

    <!-- driver -->
    <node name="$(anon compas_rrc_driver)" pkg="compas_rrc_driver" exec="driver">
        <param name="robot_ip_address" value="$(var robot_ip)" />
        <param name="robot_streaming_port" value="$(var robot_streaming_port)" />
        <param name="robot_state_port" value="$(var robot_state_port)" />
        <param name="sequence_check_mode" value="$(var sequence_check_mode)" />
    </node>
</launch>
